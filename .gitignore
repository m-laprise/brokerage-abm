plans/
runs/
archived_reports/
CLAUDE.md
AGENTS.md

# Files generated by invoking Julia with --code-coverage
*.jl.cov
*.jl.*.cov

# Files generated by invoking Julia with --track-allocation
*.jl.mem

# System-specific files and directories generated by the BinaryProvider and BinDeps packages
# They contain absolute paths specific to the host computer, and so should not be committed
deps/deps.jl
deps/build.log
deps/downloads/
deps/usr/
deps/src/

# Build artifacts for creating documentation generated by the Documenter package
docs/build/
docs/site/

# Manifest.toml IS committed: this is an application requiring a static
# environment, and the sweep data records its SHA-256 (pkg_manifest_hash).

# macOS
.DS_Store

# Log files
*.log
# Generated diagnostic outputs (reproducible by re-running the scripts)
scripts/diagnostics/_results/
scripts/diagnostics/adv_results/
*.jld2
# SLURM job logs
*.out
*.err
# LaTeX auxiliary artifacts
paper/_build/
paper/**/*.aux
